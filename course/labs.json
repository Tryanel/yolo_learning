{
  "course": {
    "title": "YOLO Learning Lab",
    "style": "lab-driven, reproducible hand-in workflow",
    "command": "python tools/course.py"
  },
  "labs": [
    {
      "id": "lab00",
      "week": 1,
      "title": "Local Environment and Course Tools",
      "points": 100,
      "required_files": [
        "submissions/lab00/environment.md",
        "submissions/lab00/time.txt"
      ],
      "checks": [
        { "type": "no_placeholder", "path": "submissions/lab00/environment.md" },
        { "type": "contains_any", "path": "submissions/lab00/environment.md", "needles": ["Python", "Ultralytics", "CUDA", "CPU", "Colab"] },
        { "type": "integer_hours", "path": "submissions/lab00/time.txt" }
      ]
    },
    {
      "id": "lab01",
      "week": 2,
      "title": "Detection Geometry: Boxes, IoU, and NMS",
      "points": 100,
      "required_files": [
        "submissions/lab01/iou_exercises.md",
        "submissions/lab01/time.txt"
      ],
      "checks": [
        { "type": "no_placeholder", "path": "submissions/lab01/iou_exercises.md" },
        { "type": "contains_any", "path": "submissions/lab01/iou_exercises.md", "needles": ["IoU", "NMS", "confidence", "threshold"] },
        { "type": "integer_hours", "path": "submissions/lab01/time.txt" }
      ]
    },
    {
